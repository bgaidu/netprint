<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <LangVersion>9.0</LangVersion>
    <Nullable>disable</Nullable>
    <AssemblyName>PrintServer</AssemblyName>
    <RootNamespace>PrintServer</RootNamespace>
    <ApplicationIcon>logo.ico</ApplicationIcon>
    <PlatformTarget>x64</PlatformTarget>
    <AutoGenerateBindingRedirects>true</AutoGenerateBindingRedirects>
    <GenerateBindingRedirectsOutputType>true</GenerateBindingRedirectsOutputType>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="System" />
    <Reference Include="System.Core" />
    <Reference Include="System.Drawing" />
    <Reference Include="System.Windows.Forms" />
    <Reference Include="System.Net.Http" />
    <Reference Include="Microsoft.CSharp" />
    <Reference Include="Microsoft.VisualBasic" />
  </ItemGroup>

  <ItemGroup>
    <!-- 允许在没有安装 .NET Framework SDK 的机器上用 dotnet 编译 net48 -->
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>

  <!-- 单文件发布: 全部资源嵌入 exe，启动时按需解压 -->
  <ItemGroup>
    <EmbeddedResource Include="wwwroot\**\*"
                      LogicalName="res.wwwroot.%(RecursiveDir)%(Filename)%(Extension)" />
    <EmbeddedResource Include="logo.ico"
                      LogicalName="res.logo.ico" />
    <EmbeddedResource Include="tools\poppler_bin\**\*"
                      LogicalName="res.poppler_bin.%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>
</Project>